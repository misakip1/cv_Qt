  <property name="styleSheet">
   <string notr="true">/* ===== 主窗口背景 ===== */
#Loding {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #f8ecf7,
        stop:1 #eadef7
    );
    border-radius: 14px;
}

/* ===== 通用标签文字 ===== */
QLabel {
    color: #6b4a87;
    font-size: 13px;
}

/* ===== 头像/图片区域 ===== */
#icon {
    border-radius: 10px;
}

/* ===== 表单卡片容器 ===== */
#widget_3 {
    background-color: rgba(255, 255, 255, 0.55);
    border-radius: 10px;
    padding: 18px 22px;
}

/* ===== 输入框 ===== */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid #d4bce6;
    border-radius: 7px;
    padding: 6px 11px;
    color: #5a3d75;
    font-size: 13px;
    min-height: 20px;
}

QLineEdit:focus {
    border-color: #c48fdd;
    background-color: #ffffff;
}

QLineEdit::placeholder {
    color: #b39dc9;
}

/* ===== 登录按钮 ===== */
QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #dba8e8,
        stop:1 #b988da
    );
    color: white;
    border: none;
    border-radius: 7px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #e2b3ed,
        stop:1 #c395e0
    );
}

QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #c995d9,
        stop:1 #ab79cc
    );
}
</string>
