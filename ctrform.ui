  <property name="styleSheet">
   <string notr="true">/* CtrForm 主窗体背景 */
#CtrForm {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #f8ecf7,
        stop:1 #eadef7
    );
}
MultiSelectComboBox
{
background: qlineargradient(
        x1:0,y1:0,x2:0,y2:1,
        stop:0 #dba8e8,
        stop:1 #b988da
    );
    color:white;
    border:none;
    border-radius:8px;
    padding:7px 16px;
    font-size:12px;
}
/* TabWidget 整体 */
QTabWidget::pane {
    border:1px solid #d4bce6;
    border-radius:8px;
    background-color:rgba(255,255,255,0.62);
}
QTabBar::tab {
    background:rgba(255,255,255,0.5);
    color:#6b4a87;
    padding:6px 14px;
    border:1px solid #d4bce6;
    border-bottom:none;
    border-top-left-radius:6px;
    border-top-right-radius:6px;
}
QTabBar::tab:selected {
    background:#dba8e8;
    color:white;
}
QTabBar::tab:hover {
    background:#e8cff2;
}

/* PushButton 按钮，新增按钮自动生效 */
QPushButton {
    background: qlineargradient(
        x1:0,y1:0,x2:0,y2:1,
        stop:0 #dba8e8,
        stop:1 #b988da
    );
    color:white;
    border:none;
    border-radius:8px;
    padding:7px 16px;
    font-size:12px;
}
QPushButton:hover {
    background: qlineargradient(
        x1:0,y1:0,x2:0,y2:1,
        stop:0 #e2b3ed,
        stop:1 #c395e0
    );
}
QPushButton:pressed {
    background: qlineargradient(
        x1:0,y1:0,x2:0,y2:1,
        stop:0 #c985d9,
        stop:1 #ab79cc
    );
}

/* Label 文字，后续新增label自动适配文字颜色 */
QLabel {
    color:#6b4a87;
    font-size:12px;
}</string>
